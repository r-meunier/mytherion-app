# FRONTEND
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database Configuration
# Database connection settings
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mytheriondb
POSTGRES_USER=mytherion
POSTGRES_PASSWORD=mytherion

# Note: For production, use strong passwords and consider using secrets management
# The Docker Compose setup uses secrets files (./secrets/pg_user.txt and ./secrets/pg_pw.txt)
# which should match the POSTGRES_USER and POSTGRES_PASSWORD values above

# Uploads
# Largest single file accepted (Spring DataSize: 512KB, 5MB, ...). Exceeding it returns 413.
# If you change it, also change MEDIA_CONSTRAINTS.MAX_SIZE_BYTES in the frontend's
# mediaService.ts, which pre-checks files before upload.
MAX_UPLOAD_FILE_SIZE=5MB
# Whole multipart request (file + fields + boundaries); keep it above MAX_UPLOAD_FILE_SIZE.
MAX_UPLOAD_REQUEST_SIZE=6MB
